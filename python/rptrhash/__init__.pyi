from array import array
from collections.abc import Iterable
from os import PathLike
from typing import Self, TypeAlias, TypeVar

from typing_extensions import Buffer

Key: TypeAlias = int | str | bytes | bytearray
_T = TypeVar("_T")

__version__: str

class MPHF:
    """Minimal perfect hash function (PtrHash) over a fixed set of distinct keys."""

    def __new__(
        cls,
        keys: Iterable[Key] | Buffer,
        *,
        compact: bool = False,
        fingerprint_bits: int = 0,
    ) -> Self: ...
    def index(self, key: Key) -> int: ...
    def __getitem__(self, key: Key) -> int: ...
    def get(self, key: Key, default: _T | None = None) -> int | _T | None: ...
    def __contains__(self, key: object) -> bool: ...
    def index_many(self, keys: Iterable[Key] | Buffer) -> array[int]: ...
    def get_many(self, keys: Iterable[Key] | Buffer, default: int = -1) -> array[int]: ...
    def __len__(self) -> int: ...
    @property
    def variant(self) -> str: ...
    @property
    def fingerprint_bits(self) -> int: ...
    @property
    def bits_per_key(self) -> float: ...
    @property
    def mphf_bits_per_key(self) -> float: ...
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(data: bytes) -> MPHF: ...
    def save(self, path: str | PathLike[str]) -> None: ...
    @staticmethod
    def load(path: str | PathLike[str]) -> MPHF: ...
